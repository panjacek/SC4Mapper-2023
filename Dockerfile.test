# syntax=docker/dockerfile:1
# Test tools layered on the runtime image. uv binary inherited from base.
FROM sc4mapper:latest
USER root

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    xauth \
    dbus-x11 \
    clang-format

# Add dev group (pytest/ruff) to /opt/venv; pyproject+uv.lock already at /app
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --group dev --no-install-package wxpython --no-editable

USER sc4user

ENV TERM=xterm-256color
ENTRYPOINT ["dbus-run-session", "--", "xvfb-run", "-a", "-s", "-screen 0 1024x768x24", "python3", "-m", "pytest", "-s", "--color=yes"]
CMD ["tests"]
